{
  "mcpServers": {
    "files": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "~"]},
    "web": {"command": "uvx", "args": ["mcp-server-fetch"]},
    "github": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-github@latest"], "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"}},
    "notes": {"command": "node", "args": ["./my-notes-server.js"]},
    "timeserver": {"command": "uvx", "args": ["mcp-server-time==0.6.2"]},
    "remote-tools": {"type": "http", "url": "http://tools.example.org/mcp"}
  }
}
